                        <td class="text-center">Aylık Toplam <h2 class="ui center aligned header">540</h2> Soru ve Çözümü</td>
                        <td class="text-center">8 Ay Toplam <h2 class="ui center aligned header">4320</h2> Soru Çözümü</td>
                    </tr>

                </tbody>
            </table>
            
        </div>
        
