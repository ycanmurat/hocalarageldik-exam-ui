                                    <div class="col">Zaten üyeyim <a href="/giris" class="btn btn-outline-primary"><i class="fa fa-user"></i> Giriş yap :)</a></div>   
                                </div>
                            </div>
                                
                        </div>                        
                    
                    </div>                    
